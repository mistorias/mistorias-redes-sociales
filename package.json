{
  "name": "mistorias-redes-sociales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "format:markdown": "prettier --write \"**/*.md\"",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"!node_modules\"",
    "spike:buffer": "node --env-file-if-exists=.env spike/buffer/spike.ts",
    "test:spike": "node --test \"spike/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@github/markdownlint-github": "^0.8.4",
    "@types/node": "^22.20.5",
    "markdown-it": "^15.0.3",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-cli2-formatter-pretty": "^0.0.10",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
