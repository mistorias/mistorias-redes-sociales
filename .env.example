# Personal Access key de Buffer (escritura).
# Ver docs/adr/0004-credenciales-y-minimo-privilegio.md.
# En CI viene del secret del environment `buffer`; en local, copia este
# archivo a .env y completa el valor.
BUFFER_API_KEY=

# Opcional. Por defecto, el feed de producción. Los tests lo apuntan a un
# servidor falso (ADR 0005).
SITE_FEED_URL=
